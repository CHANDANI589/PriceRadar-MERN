PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/priceradar
JWT_SECRET=supersecret_change_this_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# STEP 2 & 3 from your SerpApi flow: sign up free at https://serpapi.com/
# (100 free searches/month), copy your API key from the dashboard, paste it here.
# Powers real-time Live Search (real products, real images, real prices).
SERPAPI_KEY=

# Optional: get a free key at https://www.pexels.com/api/ to fetch real,
# accurately-matched stock photos for the demo catalog at seed time.
# If left blank, the catalog falls back to LoremFlickr images automatically.
PEXELS_API_KEY=
